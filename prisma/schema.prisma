generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Transaction {
  id                  String   @id @default(cuid())
  date                String
  vehicleNumber       String
  weightKg            Float
  weightTons          Float
  customerTotalAmount Float
  companyTotalAmount  Float
  rkrProfit           Float
  rkrProfitPerTon     Float
  createdAt           DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

model Invoice {
  id         String   @id @default(cuid())
  weekOf     String
  path       String
  generatedAt DateTime @default(now())
}
